{
  "name": "jansetu-backend",
  "version": "1.0.0",
  "description": "Fastify + PostgreSQL REST API Backend (TypeScript) for JanSetu DMFT Village Census Platform",
  "main": "dist/server.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "start:dev": "tsx watch src/server.ts",
    "start:cluster": "pm2 start ecosystem.config.js --env production",
    "dev": "tsx watch src/server.ts",
    "test": "tsx --test test/apiValidation.test.ts",
    "db:generate": "prisma generate",
    "db:init": "tsx src/scripts/deployInitDb.ts",
    "db:install-audit-protection": "tsx src/scripts/installAuditProtection.ts",
    "db:seed-hierarchy": "tsx src/scripts/seedHierarchy.ts",
    "db:seed-users": "tsx src/scripts/seedUsers.ts",
    "db:backup": "tsx src/scripts/backupDb.ts"
  },
  "keywords": [
    "fastify",
    "postgresql",
    "dmft",
    "census",
    "jansetu",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/compress": "^7.0.1",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/postgres": "^5.2.2",
    "@fastify/rate-limit": "^9.1.0",
    "@prisma/client": "^5.10.2",
    "dotenv": "^16.4.5",
    "fastify": "^4.26.2",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.11",
    "autocannon": "^8.0.0",
    "nodemon": "^3.1.0",
    "pm2": "^5.3.1",
    "prisma": "^5.10.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
