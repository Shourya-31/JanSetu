# Production Environment Variables Template
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# PostgreSQL Connection String (Format: postgres://user:password@host:port/dbname?connection_limit=30)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?connection_limit=30
CORS_ORIGIN=https://your-frontend.example

# JWT Security Key
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=

# Initial accounts (JSON array); use passwords of at least 12 characters.
# Example shape: [{"userCode":"admin01","fullName":"District Admin","role":"admin","password":"..."}]
INITIAL_USERS_JSON=

# PostgreSQL Hardware Tuning Overrides (Optional)
POSTGRES_MAX_WORKERS=6
POSTGRES_PARALLEL_WORKERS=4
