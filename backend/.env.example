# Backend runtime settings.
# Copy this file to .env in the backend directory for Docker Compose or local runs.
NODE_ENV=production
HOST=0.0.0.0
PORT=8080

# Docker Compose replaces DATABASE_URL with the internal PostgreSQL URL.
# For local development, replace the host and credentials as needed.
DATABASE_URL=postgresql://jansetu:replace-with-a-long-random-password@localhost:5432/jansetu?schema=public

# Use a random value of at least 32 characters.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
CORS_ORIGIN=http://localhost:8080

COMPRESS_THRESHOLD=1024
RATE_LIMIT_MAX=1000
RATE_LIMIT_WINDOW=1 minute

# Prisma's per-process pool. Keep the aggregate across all backend instances
# below PostgreSQL max_connections, leaving room for migrations/admin access.
PRISMA_CONNECTION_LIMIT=10
PRISMA_POOL_TIMEOUT=10
PRISMA_CONNECT_TIMEOUT=10
DB_RETRY_COUNT=2
DB_RETRY_DELAY_MS=75
REQUEST_TIMEOUT=30000

# Required only when image uploads are used.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

ADMIN_USERNAME=change-this-admin-name
ADMIN_PASSWORD=change-this-admin-password
SURVEYOR_USERNAME=change-this-surveyor-name
SURVEYOR_PASSWORD=change-this-surveyor-password
